VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# Optional comma-separated email allowlist in addition to the configured company domain.
VITE_FIREBASE_ALLOWED_EMAILS=
# Opt in only for local, browser-storage demo use; leave unset for deployments.
VITE_ENABLE_DEMO_MODE=
# Optional overrides; defaults come from .firebaserc and the project ID.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional override; defaults to the .firebaserc project alias.
FIREBASE_PROJECT_ID=