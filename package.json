{
  "name": "purepower-dealer-lead-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:rules": "node scripts/generate-firestore-rules.js",
    "prebuild": "npm run generate:rules",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"config/**/*.json\" firebase.json package.json vite.config.js index.html",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"config/**/*.json\" firebase.json package.json vite.config.js index.html",
    "test:rules": "firebase emulators:exec --project demo-purepower --only firestore \"node --test tests/firestore-rules.emulator.js\"",
    "import:legacy": "node scripts/import-legacy.js",
    "deploy": "npm run build && node scripts/deploy.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "vite": "8.3.4"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "firebase": "12.19.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
